# ==============================================================================
# LaundryCare — Environment Configuration Template (.env.example)
# Coursework: CS 106 / Software Engineering 1 (Deliverable 4: Deployment)
#
# Instructions:
# 1. Copy this template to a file named `.env` in the project root:
#    cp .env.example .env
# 2. Populate real production secrets directly in host environment settings
#    (e.g., Render Dashboard, Railway Variables, or Fly.io Secrets).
# 3. NEVER commit `.env` containing sensitive credentials into version control!
# ==============================================================================

# Application Environment ('production' | 'development' | 'testing')
# In 'production', debug mode is forced to False regardless of other settings.
FLASK_ENV=production

# Application Debug Mode (True | False)
# MUST BE False in production environments to avoid diagnostic trace leakage.
APP_DEBUG=False
FLASK_DEBUG=False

# Application Secret Key
# Cryptographic secret for signing session cookies and CSRF tokens.
# In production, generate a cryptographically secure random string:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_character_hex_secret_in_production

# Database File Path / Connection String
# Relative or absolute file path to the SQLite operational database.
DATABASE=laundry.db

# Host Binding & Port Configuration
# Render, Railway, and Heroku pass dynamic PORT values automatically at runtime.
HOST=0.0.0.0
PORT=5000

# Canonical Public URL for Webhooks, Barcode Generation, and SMS Routing
BASE_URL=https://laundrycare-management.onrender.com
